<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HowOld.in10YearsSlider"
             Title="in10YearsSlider">
    <Grid RowDefinitions="*,*" Margin="10">

        <Label TextColor="Red" Text="lala" Grid.Row="0" x:Name="lblResult" />

        <VerticalStackLayout  Spacing="10" Grid.Row="1" VerticalOptions="End" >
            <Label Text="Your Name:"/>
            <Entry x:Name="entryName" />

            <Label Text="What is your age:" />
            <Entry x:Name="entryAge" Keyboard="Numeric"/>

            <Slider Minimum="0" Maximum="100" ValueChanged="Slider_ValueChanged" x:Name="sliderAge" DragCompleted="sliderAge_DragCompleted"></Slider>
        </VerticalStackLayout>

    </Grid>
</ContentPage>